<!--
    Legend:
        REQUIRED     Must be included in final scripting solution
        RECOMMENDED  Associated with an optional feature; may have
                     dependencies on other recommended actions
        CUSTOMIZABLE Available for modification, within UX standards

    Each top-level comment tag applies to one or more script instructions, until the next top-level
    comment tag. A comment tag on a result code applies only to that result code.

    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
--><WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard" wizard:version="2">
    <!-- Preliminary setup for OEMs [CUSTOMIZABLE] -->
    <WizardAction id="oem_pre_setup" wizard:uri="intent:#Intent;action=com.android.setupwizard.OEM_PRE_SETUP;end"/>
    <!-- Welcome screen with language selection [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="welcome" wizard:uri="intent:#Intent;action=com.android.setupwizard.WELCOME;end">
        <result wizard:name="start_qr_provision" wizard:resultCode="101" wizard:action="check_user_unlock_qr"/>
        <result wizard:name="dpm_user_complete" wizard:resultCode="111" wizard:action="check_user_unlock_dpm_user_complete"/>
        <result wizard:name="dpm_profile_complete" wizard:resultCode="112" wizard:action="check_user_unlock_dpm_user_complete"/>
        <result wizard:name="check_user_unlock_work_setup_interrupted_qr_scan" wizard:resultCode="114" wizard:action="check_user_unlock_work_setup_interrupted_qr_scan"/>
        <result wizard:name="check_user_unlock_work_setup_interrupted_consumer_flow" wizard:resultCode="115" wizard:action="check_user_unlock_work_setup_interrupted_consumer_flow"/>
        <!--add for [EKCANCUN-3007] by huanghaodong on 2023-4-18 start-->
        <result wizard:name="check_user_unlock_nfc" wizard:resultCode="124" wizard:action="check_user_unlock_nfc"/>
        <result wizard:name="check_user_unlock_work_setup_interrupted_nfc_tap" wizard:resultCode="125" wizard:action="check_user_unlock_work_setup_interrupted_nfc_tap"/>
        <!--add for [EKCANCUN-3007] by huanghaodong on 2023-4-18 end-->
        <!--modify by EKLION-3513 for zhangzhiyuan on 2023-10-21 start -->
        <result wizard:name="provisioning_extras_not_saved" wizard:resultCode="128" wizard:action="check_user_unlock_fail_provisioning"/>
        <!--modify by EKLION-3513 for zhangzhiyuan on 2023-10-21 end -->
        <result wizard:action="demo_mode_wrapper"/>
        <!-- ape  Setup Wizard -->
    </WizardAction>
    <!--modify by EKLION-3513 for zhangzhiyuan on 2023-10-21 start -->
    <WizardAction id="check_user_unlock_fail_provisioning" wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end">
        <result wizard:action="fail_provisioning"/>
    </WizardAction>
    <!-- Device is restarted in this step -->
    <WizardAction id="fail_provisioning" wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SHOW_PROVISIONING_ERROR;end"/>
    <!--modify by EKLION-3513 for zhangzhiyuan on 2023-10-21 end -->
    <!--add for [EKCANCUN-3007] by huanghaodong on 2023-4-18 start-->
    <WizardAction id="check_user_unlock_work_setup_interrupted_nfc_tap" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end">
        <result wizard:action="work_setup_interrupted_nfc_tap"/>
    </WizardAction>
    <WizardAction id="work_setup_interrupted_nfc_tap" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.WORK_SETUP_INTERRUPTED;end">
        <result wizard:name="continue_start_nfc_provisioning" wizard:resultCode="1" wizard:action="nfc_provision_flow"/>
        <result wizard:action="factory_reset"/>
    </WizardAction>
    <WizardAction id="check_user_unlock_nfc" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end">
        <result wizard:action="nfc_provision_flow"/>
    </WizardAction>
    <WizardAction id="nfc_provision_flow" wizard:script="android.resource://com.longcheer.android.gmsintegration/raw/wizard_script_nfc_provision_flow">
        <result wizard:action="oem_post_setup"/>
    </WizardAction>
    <!--add for [EKCANCUN-3007] by huanghaodong on 2023-4-18 start-->
    <WizardAction id="check_user_unlock_work_setup_interrupted_qr_scan" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"/>
    <WizardAction id="work_setup_interrupted_qr_scan" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.WORK_SETUP_INTERRUPTED;end">
        <result wizard:name="continue_start_qr_scan" wizard:resultCode="1" wizard:action="check_user_unlock_qr"/>
        <result wizard:action="factory_reset"/>
    </WizardAction>
    <WizardAction id="check_user_unlock_work_setup_interrupted_consumer_flow" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"/>
    <WizardAction id="work_setup_interrupted_consumer_flow" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.WORK_SETUP_INTERRUPTED;end">
        <result wizard:name="continue_start_consumer_flow" wizard:resultCode="1" wizard:action="demo_mode_wrapper"/>
        <!-- ape  Setup Wizard -->
        <result wizard:action="factory_reset"/>
    </WizardAction>
    <WizardAction id="check_user_unlock_qr" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end">
        <result wizard:action="qr_provision_flow"/>
    </WizardAction>
    <WizardAction id="check_user_unlock_dpm_user_complete" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end">
        <result wizard:action="demo_mode_wrapper"/>
        <!-- ape  Setup Wizard -->
    </WizardAction>
    <!-- add by jiangguohu for EKCANCUN-21 20230329 start -->
    <!-- ape  Setup Wizard start -->
    <!--DemoMode Wrapper to start demo mode-->
    <WizardAction id="demo_mode_wrapper" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.DEMO_MODE_WRAPPER;end">
        <result wizard:name="demo_mode_enabled" wizard:action="demo_mode_start" wizard:resultCode="120"/>
        <result wizard:name="demo_privacy" wizard:action="demo_privacy" wizard:resultCode="121"/>
        <result wizard:action="slots_selection"/>
    </WizardAction>
    <!-- Set up as a Moto demo device -->
    <WizardAction id="demo_mode_start" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_moto_demo_mode_flow">
        <!-- Skip oem_post_setup if entering demo mode -->
        <result wizard:action="exit"/>
    </WizardAction>
    <!-- ape  Setup Wizard start -->
    <WizardAction id="check_user_unlock" wizard:uri="intent:#Intent;action=com.android.setupwizard.CHECK_USER_UNLOCK;end">
        <result wizard:action="demo_mode_wrapper"/>
    </WizardAction>
    <!-- add by jiangguohu for EKCANCUN-21 20230329 end -->
    <!-- Check which existing profile should be enabled [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="slots_selection" wizard:uri="intent:#Intent;action=com.android.setupwizard.SLOTS_SELECTION;end">
        <result wizard:name="skip" wizard:resultCode="1" wizard:action="sim_missing"/>
        <result wizard:action="carrier_setup"/>
    </WizardAction>
    <!-- Notify user if expected SIM is not found [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="sim_missing" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.SIM_CARD_GRAPHIC;end">
        <result wizard:name="esim" wizard:resultCode="101" wizard:action="esim_intro"/>
        <result wizard:name="esim_only" wizard:resultCode="102" wizard:action="carrier_setup"/>
    </WizardAction>
    <WizardAction id="sim_ready" wizard:uri="intent:#Intent;action=com.android.setupwizard.SIM_READY;end">
        <result wizard:action="carrier_setup"/>
    </WizardAction>
    <WizardAction id="esim_intro" wizard:uri="intent:#Intent;action=com.android.setupwizard.ESIM_INTRO;end"/>
    <!-- Activate carrier services [RECOMMENDED] -->
    <WizardAction id="carrier_setup" wizard:uri="intent:#Intent;action=com.android.setupwizard.CARRIER_SETUP;end">
        <result wizard:name="all_subscriptions_completed" wizard:resultCode="98765" wizard:action="moto_sim_setup_wrapper"/>
        <result wizard:name="skip" wizard:resultCode="1" wizard:action="moto_sim_setup_wrapper"/>
        <!-- Return to carrier_setup to check for other subscriptions for multi-SIM -->
        <result wizard:action="carrier_setup"/>
    </WizardAction>
    <!-- ape  Setup Wizard start -->
    <WizardAction id="moto_sim_setup_wrapper" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.SIM_SETUP_WRAPPER;end">
        <result wizard:name="unlock" wizard:action="unlock_sim" wizard:resultCode="3"/>
        <result wizard:name="multisim" wizard:action="moto_sim_setup" wizard:resultCode="2"/>
        <result wizard:name="apn_setting" wizard:action="apn_setting" wizard:resultCode="4"/>
        <result wizard:action="sim_setup"/>
    </WizardAction>
    <!--Select Data screen for network switch -->
    <WizardAction id="moto_sim_setup" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.SIM_SETUP;end">
        <result wizard:action="apn_setting"/>
    </WizardAction>
    <!-- ape  Setup Wizard start -->
    <!-- On multi-SIM devices, choose which SIM to use for voice, data, and text [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="sim_setup" wizard:uri="intent:#Intent;action=com.android.setupwizard.SIM_SETUP;end"/>
    <WizardAction id="apn_setting" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.APN_SETTING;end"/>
    <!--modify by EKLION-3513 for zhangzhiyuan on 2023-10-21 start -->
    <!-- Security warning (for enterprise) [RECOMMENDED] -->
    <WizardAction id="device_owner_warning" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.DEVICE_OWNER_WARNING;end">
        <result wizard:name="skip" wizard:resultCode="1" wizard:action="check_frp"/>
    </WizardAction>
    <!-- Factory reset should cause a reboot, but if it returns unexpectedly, continue on to check_frp -->
    <WizardAction id="factory_reset" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.FACTORY_RESET;end"/>
    <!-- Wait to check factory reset protection status [RECOMMENDED] -->
    <WizardAction id="check_frp" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.CHECK_FRP;end"/>
    <!--modify by EKLION-3513 for zhangzhiyuan on 2023-10-21 end -->
    <!-- Network selection and packages update [REQUIRED, CUSTOMIZABLE] -->
    <WizardAction id="connect_and_update" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_connect_and_update_flow">
        <result wizard:name="setup_offline" wizard:resultCode="1" wizard:action="no_network_flow"/>
    </WizardAction>
    <!-- Zero touch provisioning (for enterprise). This feature depends on Android Checkin and Early update. Place this action after Android Checkin and Early update, but before restore. [REQUIRED]. -->
    <WizardAction id="zero_touch" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_zero_touch_flow">
        <result wizard:name="dpm_user_complete" wizard:resultCode="111" wizard:action="post_dpm_user_flow"/>
        <!-- The restore flow would be set to cloud for COPE devices if the result code returned the adding personal account. -->
        <result wizard:name="add_personal_account_after_work_profile" wizard:resultCode="120" wizard:action="add_personal_account_after_work_profile"/>
        <result wizard:name="financed_device_provisioning_complete" wizard:resultCode="121" wizard:action="setup_as_new_flow"/>
        <result wizard:name="work_profile_setup" wizard:resultCode="122" wizard:action="work_profile_setup"/>
        <result wizard:name="device_owner_setup" wizard:resultCode="123" wizard:action="post_dpm_user_flow"/>
        <!-- GmsCore will handle ZeroTouch. Go to setup_as_new flow, it will handle ZeroTouch and FRP -->
        <result wizard:name="gmscore_zero_touch" wizard:resultCode="116" wizard:action="setup_as_new_flow"/>
    </WizardAction>
    <!-- Restore from an existing account or device [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="unified_restore_flow" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_unified_restore_flow">
        <result wizard:action="oem_post_setup"/>
    </WizardAction>
    <WizardAction id="work_profile_setup" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_post_dpm_provision_finalization_flow">
        <result wizard:action="transition_to_personal_profile_setup"/>
    </WizardAction>
    <!-- Set up without a network connection [RECOMMENDED] -->
    <WizardAction id="no_network_flow" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_no_network_flow">
        <result wizard:action="oem_post_setup"/>
    </WizardAction>
    <WizardAction id="transition_to_personal_profile_setup" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.TRANSITION_TO_PERSONAL_PROFILE_SETUP;end">
        <result wizard:action="add_personal_account_after_work_profile"/>
    </WizardAction>
    <!-- Add personal account after work profile provisioning [REQUIRED] -->
    <WizardAction id="add_personal_account_after_work_profile" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_account_flow">
        <result wizard:action="oem_post_setup"/>
    </WizardAction>
    <!-- Setup as new [REQUIRED] -->
    <WizardAction id="setup_as_new_flow" wizard:flow="SetupAsNewFlow" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_account_flow">
        <result wizard:action="oem_post_setup"/>
    </WizardAction>
    <!-- Flow to run after a user-led device policy managed setup. [RECOMMENDED] -->
    <WizardAction id="post_dpm_user_flow" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_post_dpm_user_flow">
        <result wizard:action="oem_post_setup"/>
    </WizardAction>
    <!-- QR provision flow (for enterprise) [RECOMMENDED] -->
    <WizardAction id="qr_provision_flow" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_qr_provision_flow">
        <!-- add for EKCANCUN-6712 huanghaodong 20230602 start-->
        <result wizard:action="moto_privacy_update_control"/>
        <!-- add for EKCANCUN-6712 huanghaodong 20230602 end-->
    </WizardAction>
    <!-- OEM completion [CUSTOMIZABLE] -->
    <WizardAction id="oem_post_setup" wizard:uri="intent:#Intent;action=com.android.setupwizard.OEM_POST_SETUP;end"/>
    <!-- Jio [REQUIRED, CUSTOMIZABLE] -->
    <WizardAction wizard:ifLifecycle="default" id="jio_wrapper" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.JIO_WRAPPER;end">
        <result wizard:action="jio_oem_post_setup2" wizard:name="skip" wizard:resultCode="1"/>
        <result wizard:action="enterprise_finalization_flow"/>
    </WizardAction>
    <!-- OEM integrate Jio [CUSTOMIZABLE] -->
    <WizardAction id="jio_oem_post_setup2" wizard:uri="intent:#Intent;action=action.setupwizardext.setupcomplete;end">
        <result wizard:resultCode="111" wizard:action="oem_sl_input_provisioning"/>
    </WizardAction>
    <WizardAction id="oem_sl_input_provisioning" wizard:uri="intent:#Intent;action=com.android.setupwizard.JIO_INPUT_PROVISIONING;end">
        <result wizard:resultCode="102" wizard:action="oem_post_setup_provisioning"/>
    </WizardAction>
    <WizardAction id="oem_post_setup_provisioning" wizard:uri="intent:#Intent;action=com.android.setupwizard.JIO_PROVISIONING;end">
        <result wizard:resultCode="101" wizard:action="enterprise_finalization_flow"/>
    </WizardAction>
    <!-- Enterprise provisioning finalization flow. Required only in init setup flow. [REQUIRED] -->
    <WizardAction id="enterprise_finalization_flow" wizard:script="android.resource://com.ape.setupwizard/raw/wizard_script_post_dpm_provision_finalization_flow">
        <!--modify for [EKCANCUN-5927] by huanghaodong on 2023-5-26 start-->
        <result wizard:action="exit" wizard:name="skip" wizard:resultCode="-1"/>
        <!--modify for [EKCANCUN-5927] by huanghaodong on 2023-5-26 end-->
    </WizardAction>
    <WizardAction wizard:ifLifecycle="default" id="glance_wrapper" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.GLANCE_WRAPPER;end">
        <result wizard:action="glance_setting" wizard:name="skip" wizard:resultCode="1"/>
        <result wizard:action="moto_stay_in_the_know"/>
    </WizardAction>
    <WizardAction wizard:ifLifecycle="default" id="glance_setting" wizard:uri="intent:#Intent;action=com.glance.action.oobe;end"/>
    <!-- ape  Setup Wizard start -->
    <WizardAction wizard:ifLifecycle="default" id="moto_stay_in_the_know" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.STAY_IN_THE_KNOW;end"/>
    <WizardAction wizard:ifLifecycle="default" id="moto_there_more" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.THERE_MORE;end"/>
    <!--modify for [EKCANCUN-42] by huanghaodong on 2023-3-30 start-->
    <!-- modify for [EKSABAHL-6214] by hushunfu on 2022-11-18 begin-->
    <WizardAction wizard:ifLifecycle="default" id="cpf_wrapper" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.CPF_WRAPPER;end">
        <!--add for [EKCANCUN-42] by huanghaodong on 2023-3-30 start-->
        <result wizard:action="moto_navigation" wizard:name="skip" wizard:resultCode="1"/>
        <!--add for [EKCANCUN-42] by huanghaodong on 2023-3-30 end-->
        <result wizard:action="moto_cpf"/>
    </WizardAction>
    <!--modify for [EKCANCUN-42] by huanghaodong on 2023-3-30 end-->
    <WizardAction wizard:ifLifecycle="default" id="moto_cpf" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.ALMOST_THERE;end"/>
    <!-- modify for [EKSABAHL-6214] by hushunfu on 2022-11-18 end-->
    <WizardAction wizard:ifLifecycle="default" id="moto_navigation" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.MOTO_NAVIGATION;end">
        <result wizard:action="moto_family_space"/>
    </WizardAction>
    <WizardAction wizard:ifLifecycle="default" id="moto_family_space" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.FAMILY_SPACE;end"/>
    <WizardAction wizard:ifLifecycle="default" id="taboola_wrapper" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.TABOOLA_WRAPPER;end">
        <result wizard:action="taboola_setting" wizard:name="skip" wizard:resultCode="1"/>
        <result wizard:action="paks_financed_setup"/>
    </WizardAction>
    <WizardAction wizard:ifLifecycle="default" id="taboola_setting" wizard:uri="intent:#Intent;action=com.taboola.ody.action.START_OOBE;end"/>
    <!--paks -->
    <WizardAction wizard:ifLifecycle="default" id="paks_financed_setup" wizard:uri="intent:#Intent;action=com.motorola.paks.action.financed_setup;end">
        <result wizard:action="moto_finish"/>
    </WizardAction>
    <WizardAction wizard:ifLifecycle="default" id="moto_finish" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.MOTO_FINISH;end"/>
    <!-- ape  Setup Wizard end -->
    <!-- add by jiangguohu for EKCANCUN-21 20230329 start -->
    <!-- Google kid account setup. Must be the last setup action. [REQUIRED] -->
    <WizardAction id="kid_post_setup" wizard:uri="intent:#Intent;action=com.google.android.setupwizard.KID_POST_SETUP;end">
        <result wizard:action="exit"/>
    </WizardAction>
    <WizardAction id="demo_privacy" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.MOTO_PRIVACY_UPDATE_CONTROL;end">
        <result wizard:action="date_time"/>
    </WizardAction>
    <WizardAction id="date_time" wizard:uri="intent:#Intent;action=com.android.setupwizard.DATE_TIME;end">
        <result wizard:action="exit"/>
    </WizardAction>
    <!-- add by jiangguohu for EKCANCUN-21 20230329 end -->
    <!-- add for EKCANCUN-6712 huanghaodong 20230602 start-->
    <WizardAction id="moto_privacy_update_control" wizard:ifLifecycle="default" wizard:uri="intent:#Intent;action=com.moto.android.setupwizard.MOTO_PRIVACY_UPDATE_CONTROL;end"/>
    <!-- add for EKCANCUN-6712 huanghaodong 20230602 end-->
    <!-- Leave Setup Wizard [REQUIRED] -->
    <WizardAction id="exit" wizard:uri="intent:#Intent;action=com.android.setupwizard.EXIT;end"/>
</WizardScript>
